# WhatsApp Cloud API (required when TRANSPORT=whatsapp)
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=lingo-dev-verify-token
# Optional but recommended: App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=

# Call transport: whatsapp (Meta Cloud API) or web (browser UI on LAN)
TRANSPORT=whatsapp

# Bot mode: conversation (real STT/LLM/TTS), echo_utterance, or echo_live
BOT_MODE=conversation

# ElevenLabs API (required for conversation mode)
ELEVENLABS_API_KEY=replace-me
# Voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI API (required for conversation mode)
OPENAI_API_KEY=replace-me
# Model: gpt-4o, gpt-4o-mini, gpt-6-luna, etc.
OPENAI_MODEL=gpt-6-luna

# PostgreSQL and protected learner identity (required for WhatsApp conversation mode)
DATABASE_URL=postgresql+psycopg://lingo:lingo@db:5432/lingo
LEARNER_ID_SECRET=replace-with-a-long-random-secret

# Server bind
# TRANSPORT=web defaults to your LAN IP when HOST is unset or HOST=auto
# Use 0.0.0.0 to listen on all interfaces (Docker / WhatsApp)
# HOST=auto
PORT=7860

# Web transport (TRANSPORT=web): HTTPS so phones can use the microphone
# Defaults to true for web, false for whatsapp
# WEB_HTTPS=true
# WEB_CERT_DIR=.lingo-certs

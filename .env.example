# WhatsApp Cloud API
WHATSAPP_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=lingo-dev-verify-token
# Optional but recommended: App > Settings > Basic > App Secret
WHATSAPP_APP_SECRET=

# Echo behavior: utterance (replay after silence) or live (immediate loopback)
ECHO_MODE=utterance

# Server bind
HOST=0.0.0.0
PORT=7860
